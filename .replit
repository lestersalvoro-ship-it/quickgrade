# Replit configuration for QuickGrade (Node.js server + React web app).
modules = ["nodejs-22"]
run = "npm install && npm run build && npm start"

[env]
HOST = "0.0.0.0"
PORT = "3000"
TRUST_PROXY = "true"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm install && npm run build"]
run = ["npm", "start"]
