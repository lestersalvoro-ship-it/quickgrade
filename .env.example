# QuickGrade configuration. Copy to .env and adjust. Never commit a real .env.

# --- Server ---------------------------------------------------------------
NODE_ENV=development            # development | production
HOST=127.0.0.1                  # use 0.0.0.0 inside Docker / to reach it from a phone on your LAN
PORT=3000
APP_URL=http://localhost:5173   # public URL; used in password-reset links (production: https://grade.yourschool.ph)
DATA_DIR=./data                 # SQLite database + private scan images live here — back this up
# DATABASE_FILE=./data/quickgrade.db
# COOKIE_SECURE=true            # defaults to true when NODE_ENV=production (requires HTTPS)
TRUST_PROXY=false               # true when running behind a reverse proxy (Caddy, nginx, Render, Fly)
SESSION_DAYS=14
MAX_UPLOAD_MB=15

# --- Email (password reset) -----------------------------------------------
# Leave SMTP_HOST empty in development: reset links are printed to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="QuickGrade <no-reply@example.com>"

# --- AI (optional — scanning and grading never need it) --------------------
AI_PROVIDER=anthropic           # anthropic | none
ANTHROPIC_API_KEY=              # sk-ant-... ; keep server-side only
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=120000
AI_DAILY_REQUESTS_PER_TEACHER=40
AI_MONTHLY_BUDGET_USD=20        # server-wide estimated spend cap; 0 = no cap
AI_INPUT_USD_PER_MTOK=4         # used for cost estimates only
AI_OUTPUT_USD_PER_MTOK=20
